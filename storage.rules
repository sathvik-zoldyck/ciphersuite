rules_version = '2';

// Evidence files live at evidence/{projectId}/{file}. Only the owner of the
// project (the `ownerId` on the Firestore project document) can read or write
// them. Uploads are capped at 50 MB per file.
service firebase.storage {
  match /b/{bucket}/o {
    function ownsProject(projectId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /evidence/{projectId}/{allPaths=**} {
      allow read, delete: if ownsProject(projectId);
      allow create, update: if ownsProject(projectId)
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
